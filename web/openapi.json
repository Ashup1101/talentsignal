  "info": {
    "summary": "How a resume compares with real job postings.",
    "title": "TalentSignal API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/analyze": {
      "post": {
        "description": "Analyze a resume PDF (the raw request body) against real postings for a target role.\n\nThe PDF is read in memory, never stored or logged; the response never includes its text.",
        "operationId": "analyze_api_analyze_post",
        "parameters": [
          {
            "description": "Target role (see /api/options)",
            "examples": {
              "data analyst": {
                "value": "data analyst"
              },
              "data engineer": {
                "value": "data engineer"
              },
              "data scientist": {
                "value": "data scientist"
              },
              "machine learning engineer": {
                "value": "machine learning engineer"
