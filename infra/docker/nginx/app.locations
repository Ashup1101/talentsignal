# What the site serves, in both modes (included by http.conf and https.conf): the static
# Next.js export (web/out/) and /api/ proxied to the API container. Server-level
# directives only; the upstream and the rate-limit zone are in 00-http.conf.
root /usr/share/nginx/html;
server_tokens off;
absolute_redirect off;  # /analyze → /analyze/ keeps the visitor's host and port

add_header X-Content-Type-Options "nosniff" always;
add_header X-Frame-Options "DENY" always;
add_header Referrer-Policy "strict-origin-when-cross-origin" always;
add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;

gzip on;
gzip_min_length 1024;
gzip_types text/css application/javascript application/json image/svg+xml text/plain;

# --- Pages: each route is a folder with index.html (trailingSlash export) ---------------
location / {
    try_files $uri $uri/ =404;
    expires epoch;  # HTML revalidates on every visit, so a deploy shows at once
}
location /_next/static/ {
    expires max;  # file names carry a content hash
}
error_page 404 /404.html;

# --- API -----------------------------------------------------------------------------
location /api/ {
    proxy_pass http://api;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 60s;
    client_max_body_size 1m;
}

location = /api/analyze {
    limit_req zone=analyze burst=10 nodelay;
    limit_req_status 429;
    # The API refuses resumes over 5 MB with its own message; nginx allows a little more.
    client_max_body_size 6m;
    # Privacy: a resume never touches disk here. nginx writes request bodies over
    # client_body_buffer_size to a temp file by default; this keeps up to 6 MB in
    # memory and streams it to the API instead of buffering it first.
    client_body_buffer_size 6m;
    proxy_request_buffering off;
    proxy_pass http://api;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 60s;
}

# nginx's own errors in the API's shape ({detail, code}), which the frontend shows.
error_page 413 = @too_large;
error_page 429 = @rate_limited;
error_page 502 503 504 = @unavailable;
location @too_large {
    default_type application/json;
    return 413 '{"detail":"That file is over the 5 MB limit. Please upload a smaller PDF.","code":"too_large"}';
}
location @rate_limited {
    default_type application/json;
    return 429 '{"detail":"Too many requests. Please wait a minute and try again.","code":"rate_limited"}';
}
location @unavailable {
    default_type application/json;
    return 503 '{"detail":"TalentSignal is unavailable right now. Please try again in a minute.","code":"unavailable"}';
}
